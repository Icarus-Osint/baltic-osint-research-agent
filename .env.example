# Copy this file to automation/.env before running live scripts.
# NEVER commit automation/.env or paste real API keys into source control.

# --- Gemini Discovery Workflow (automation/run_gemini_research.py) ---
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Mistral Safeguarded Batch Workflow & Smoke Test ---
# Used by automation/run_mistral_research.py and automation/test_mistral_connection.py
MISTRAL_API_KEY=PASTE_YOUR_MISTRAL_API_KEY_HERE
MISTRAL_MODEL=mistral-small-latest
